# ── База данных ────────────────────────────────────────────────
# Эти три переменные использует docker-compose для контейнера PostgreSQL.
# Пароль — без символов @ : / ? # (он подставляется в строку подключения).
POSTGRES_DB=master
POSTGRES_USER=master
POSTGRES_PASSWORD=change-me

# Строка подключения для запуска без Docker (npm run dev).
# В docker-compose она собирается автоматически из переменных выше.
DATABASE_URL=postgresql://master:change-me@localhost:5433/master

# ── Приложение ─────────────────────────────────────────────────
# Публичный адрес сайта. Если адрес https://, cookie админки будут помечены как secure.
APP_URL=http://localhost:3000
# Часовой пояс сервиса: от него считаются «сегодня» и прошедшие интервалы.
APP_TIMEZONE=Europe/Moscow
# Порт, на котором docker-compose опубликует сайт.
APP_PORT=3000

# Секрет для подписи сессий админки — случайная строка от 32 символов.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Первый администратор. Создаётся при запуске, если в базе ещё нет ни одного.
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=
